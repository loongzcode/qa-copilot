# backend service base url, local FastAPI environment
VITE_SERVICE_BASE_URL=http://127.0.0.1:8000/api

# Load constant and authorized routes from the FastAPI backend.
VITE_AUTH_ROUTE_MODE=dynamic

# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9528"
}`
