APP_NAME=RAG Agent
APP_ENV=development
TEST_ENV_ALLOW_LOOPBACK=false
AUTOMATION_EXECUTION_DEFAULT_TIMEOUT_SECONDS=300
AUTOMATION_EXECUTION_MAX_TIMEOUT_SECONDS=1800
AUTOMATION_RESPONSE_MAX_BYTES=2097152
AUTOMATION_EXECUTION_TEMP_DIR=data/automation-executions
AUTOMATION_EXECUTION_RECOVERY_GRACE_SECONDS=60
DEBUG=true
API_PREFIX=/api
# MCP 使用现有登录接口签发的 Bearer 访问令牌，不单独维护另一套账号。
MCP_ENABLED=true
MCP_ISSUER_URL=http://127.0.0.1:8000
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8000/api/mcp/
SECRET_KEY=change-me
# 使用 Fernet.generate_key() 单独生成；不能与 SECRET_KEY 相同。
DATA_ENCRYPTION_KEY=replace-with-a-fernet-key
# 密钥轮换期间可临时填写旧密钥；迁移完成后应删除。
DATA_ENCRYPTION_PREVIOUS_KEYS=[]

# 平台允许测试环境访问的私网 CIDR；仅支持 RFC1918 和 IPv6 ULA。
# 项目仍需配置精确域名白名单；配置 * 时不会使用这些私网范围。
TEST_ENV_ALLOWED_PRIVATE_NETWORKS=[]
NOTIFICATION_ALLOWED_PRIVATE_NETWORKS=[]
NOTIFICATION_ALLOW_LOOPBACK=false
TOOL_ALLOWED_PRIVATE_NETWORKS=[]
TOOL_ALLOW_LOOPBACK=false

# 知识文档原文件存储：开发环境默认使用 local，生产环境可使用 minio 或 s3。
KNOWLEDGE_DOCUMENT_STORAGE_BACKEND=local
KNOWLEDGE_DOCUMENT_STORAGE_DIR=data/knowledge-documents
# S3/MinIO endpoint 只写 host:port，不要带 http:// 或 https://。
# BACKEND=local 时以下配置不会生效；生产环境建议预先创建 Bucket，并关闭自动创建。
KNOWLEDGE_DOCUMENT_S3_ENDPOINT=127.0.0.1:9000
KNOWLEDGE_DOCUMENT_S3_ACCESS_KEY=
KNOWLEDGE_DOCUMENT_S3_SECRET_KEY=
KNOWLEDGE_DOCUMENT_S3_SESSION_TOKEN=
KNOWLEDGE_DOCUMENT_S3_BUCKET=qa-copilot-documents
KNOWLEDGE_DOCUMENT_S3_SECURE=false
KNOWLEDGE_DOCUMENT_S3_REGION=
KNOWLEDGE_DOCUMENT_S3_AUTO_CREATE_BUCKET=false
KNOWLEDGE_DOCUMENT_MAX_SIZE_BYTES=20971520
KNOWLEDGE_DOCUMENT_CHUNK_SIZE_TOKENS=800
KNOWLEDGE_DOCUMENT_CHUNK_OVERLAP_TOKENS=120
# 流式解析单段字符上限，以及单篇文档允许进入索引的切片/Token 总量。
KNOWLEDGE_DOCUMENT_SECTION_MAX_CHARS=65536
KNOWLEDGE_DOCUMENT_MAX_CHUNKS=10000
KNOWLEDGE_DOCUMENT_MAX_INDEX_TOKENS=500000
KNOWLEDGE_EMBEDDING_BATCH_SIZE=20
# 每次交给模型生成测试用例的需求缺口数量；过大会增加 JSON 被截断的风险。
CASE_GENERATION_BATCH_SIZE=5

# PostgreSQL async connection URL
DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:5432/rag_fastapi

REDIS_URL=redis://127.0.0.1:6379/0
# FastAPI 通过 /metrics/ 暴露指标；Celery Worker 是独立进程，需要单独端口。
# 同一宿主机直接运行多个 Worker 时每个实例必须使用不同端口；0 表示不启动。
METRICS_ENABLED=true
METRICS_WORKER_HOST=0.0.0.0
METRICS_WORKER_PORT=0
# 多进程部署时在启动脚本中设置并在每次启动前清空该目录：
# PROMETHEUS_MULTIPROC_DIR=/tmp/qa-copilot-prometheus
OUTBOX_PUBLISH_BATCH_SIZE=20
OUTBOX_PUBLISH_INTERVAL_SECONDS=2
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_PROCESSING_TIMEOUT_SECONDS=120
BACKGROUND_RECOVERY_INTERVAL_SECONDS=60
BACKGROUND_RECOVERY_BATCH_SIZE=100
BACKGROUND_PENDING_TIMEOUT_SECONDS=300
BACKGROUND_RUNNING_TIMEOUT_SECONDS=3600
KNOWLEDGE_DOCUMENT_PENDING_TIMEOUT_SECONDS=180
KNOWLEDGE_DOCUMENT_PROCESSING_TIMEOUT_SECONDS=1800
KNOWLEDGE_DOCUMENT_MAX_RECOVERIES=3
CORS_ORIGINS=["http://localhost:9527","http://127.0.0.1:9527","http://localhost:5173"]
